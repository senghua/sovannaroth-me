---
import { Image } from "astro:assets";
import avatar from "../assets/sovannaroth.png";

const principles = [
  { title: "Research-driven", body: "User research and usability testing shape every decision I make." },
  { title: "Systems thinking", body: "I design for the whole ecosystem — web and mobile — so products stay consistent as they scale." },
  { title: "Cross-functional", body: "Good design happens in the room with product, engineering, and business, not after." },
  { title: "Mentorship", body: "I train and guide junior designers, because good design practice should scale with the team." },
];
---

<section id="about" class="section section-bg">
  <div class="wrap about-grid">
    <div class="about-portrait reveal-scale">
      <Image src={avatar} alt="Portrait of Sovannaroth Ry" width={800} height={800} quality="high" class="portrait-img" />
    </div>

    <div class="about-copy">
      <p class="eyebrow reveal">About</p>
      <h2 class="section-heading reveal">I turn complexity into clarity</h2>
      <p class="about-bio reveal">
        I'm a UX/UI designer based in Phnom Penh with 5+ years across multimedia, e-commerce, and
        product design. I currently lead end-to-end design — from user research and wireframes through
        high-fidelity UI — for a food delivery platform's Customer, Driver, Merchant, and Admin experiences
        across web and mobile. I work closely with product managers, engineers, and stakeholders to turn user
        needs and business goals into design solutions, and I've built and maintained the design system that
        keeps all four platforms consistent as they scale. Before that, I shaped brand and web experience for
        a furniture retailer, and produced multimedia campaigns for consumer electronics brands like Xiaomi
        and Amazfit. I also volunteer as Lead UX/UI Designer for a local community organization, where I
        mentor junior designers.
      </p>

      <div class="principles">
        {
          principles.map((p) => (
            <div class="principle reveal">
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: 56px;
    align-items: start;
  }

  @media (min-width: 860px) {
    .about-grid {
      grid-template-columns: 300px 1fr;
      gap: 80px;
    }
  }

  .about-portrait {
    justify-self: center;
  }

  .portrait-img {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 24px 48px -20px rgba(29, 29, 31, 0.28);
  }

  @media (min-width: 860px) {
    .portrait-img {
      width: 280px;
      height: 280px;
    }
  }

  .about-bio {
    max-width: 640px;
    color: var(--color-ink-soft);
    font-size: 17px;
    line-height: 1.7;
    margin-top: 4px;
  }

  .principles {
    display: grid;
    gap: 24px;
    margin-top: 48px;
  }

  @media (min-width: 560px) {
    .principles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .principle h3 {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 6px;
  }

  .principle p {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
</style>
