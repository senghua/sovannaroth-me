---
interface Props {
  label: string;
  accent: string;
  variant?: "phone" | "browser";
}
const { label, accent, variant = "phone" } = Astro.props;
---

<div class:list={["mock", variant]} style={`--accent: ${accent}`}>
  <div class="glow"></div>
  <div class="mock-inner">
    <div class="mock-bar">
      <span class="mock-dot"></span>
      <span class="mock-line"></span>
    </div>
    <div class="mock-cards">
      <span class="card card-a"></span>
      <span class="card card-b"></span>
      {variant === "phone" && <span class="card card-c"></span>}
    </div>
    <p class="mock-label">{label}</p>
  </div>
</div>

<style>
  .mock {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 88%, white 0%) 0%, color-mix(in srgb, var(--accent) 60%, black 25%) 100%);
    overflow: hidden;
  }

  .glow {
    position: absolute;
    top: -30%;
    right: -20%;
    width: 70%;
    height: 70%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 40%, white 60%) 0%, transparent 70%);
    opacity: 0.55;
  }

  .mock-inner {
    position: relative;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .browser .mock-inner {
    padding: 24px;
    gap: 18px;
    height: 100%;
    justify-content: center;
  }

  .mock-bar {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mock-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    flex: none;
  }

  .mock-line {
    height: 8px;
    width: 45%;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.4);
  }

  .mock-cards {
    display: flex;
    gap: 10px;
  }

  .browser .mock-cards {
    gap: 16px;
  }

  .card {
    display: block;
    flex: 1;
    height: 64px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .browser .card {
    height: 110px;
  }

  .card-a {
    background: rgba(255, 255, 255, 0.92);
  }

  .mock-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
  }

  .browser .mock-label {
    font-size: 14px;
  }
</style>
