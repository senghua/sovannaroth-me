---
import { Image } from "astro:assets";
const { project } = Astro.props;
---

<dialog id={`cs-${project.slug}`} class="case-dialog" style={`--accent: ${project.accent}`}>
  <button class="case-close" type="button" data-close-case aria-label="Close case study">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  </button>

  {
    project.screens.length > 0 && (
      <div class="mock-list">
        {project.screens.map((screen: ImageMetadata) => (
          <Image src={screen} alt={`${project.name} screen`} width={2400} quality={90} class="case-screen" />
        ))}
      </div>
    )
  }
</dialog>

<style>
  .case-dialog {
    width: min(1200px, 94vw);
    max-height: 90vh;
    padding: 0;
    border: none;
    border-radius: 20px;
    overflow: hidden;
    overflow-y: auto;
    color: var(--color-ink);
    opacity: 1;
    transform: scale(1);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out);
  }

  .case-dialog[data-closing] {
    opacity: 0;
    transform: scale(0.97);
  }

  .case-dialog::backdrop {
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(14px);
    transition: opacity 200ms var(--ease-out);
  }

  .case-dialog[data-closing]::backdrop {
    opacity: 0;
  }

  .case-close {
    position: fixed;
    top: 18px;
    right: 18px;
    z-index: 1;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    border: none;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 200ms var(--ease-out);
  }

  .case-close:hover {
    background: rgba(0, 0, 0, 0.85);
  }

  .mock-list {
    display: flex;
    flex-direction: column;
  }

  .case-screen {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
