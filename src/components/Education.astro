---
import { Image } from "astro:assets";
import certificate from "../assets/certificate.jpg";

const education = [
  { school: "Coursera", program: "Google UX Design Professional Certificate", period: "2025 — 2026", link: "#edu-cert" },
  { school: "DICHI Academy", program: "UX/UI Design: Practical Design for Modern Interfaces", period: "Nov 2025 — Jan 2026" },
  { school: "SETEC Institute", program: "Management Information Systems, General", period: "2024 — Present" },
  { school: "Coursera", program: "Creative Design Tools: Adobe Photoshop, Illustrator, Acrobat (Adobe)", period: "Jan 2026 — Mar 2026", link: "https://www.coursera.org/account/accomplishments/specialization/0QBA1SAIQ8LS" },
];
---

<section id="education" class="section">
  <div class="wrap">
    <p class="eyebrow reveal center">Education</p>
    <h2 class="section-heading reveal center">Continuous learning</h2>

    <ul class="edu-list reveal">
      {
        education.map((e) => {
          const Tag = e.link ? "a" : "div";
          const external = e.link?.startsWith("http");
          return (
            <li class="edu-item">
              <Tag
                class="edu-item-inner"
                href={e.link}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                <div class="edu-text">
                  <span class="edu-subtitle">{e.school}</span>
                  <span class="edu-title">{e.program}</span>
                </div>
                <span class="edu-date">{e.period}</span>
              </Tag>
            </li>
          );
        })
      }
    </ul>

    <div id="edu-cert" class="edu-cert reveal">
      <Image src={certificate} alt="Google UX Design Professional Certificate" width={1200} quality={100} class="edu-cert-img" />
    </div>
  </div>
</section>

<style>
  .edu-list {
    max-width: 640px;
    margin: 48px auto 0;
  }

  .edu-item {
    border-top: 1px solid var(--color-border);
    font-size: 15px;
  }

  .edu-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .edu-item-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    color: inherit;
    text-decoration: none;
  }

  a.edu-item-inner {
    cursor: pointer;
    transition: opacity 200ms var(--ease-out);
  }

  a.edu-item-inner:hover {
    opacity: 0.7;
  }

  a.edu-item-inner:hover .edu-title {
    color: var(--color-primary);
  }

  .edu-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .edu-title {
    font-weight: 500;
    transition: color 200ms var(--ease-out);
  }

  .edu-subtitle {
    color: var(--color-ink-soft);
    font-size: 14px;
  }

  .edu-date {
    color: var(--color-ink-soft);
    font-size: 14px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .edu-cert {
    max-width: 560px;
    margin: 64px auto 0;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 44px -20px rgba(29, 29, 31, 0.22);
    transition: transform 320ms var(--ease-out), box-shadow 320ms var(--ease-out);
  }

  .edu-cert:hover {
    transform: translateY(-4px);
    box-shadow: 0 28px 56px -20px rgba(29, 29, 31, 0.28);
  }

  .edu-cert-img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
