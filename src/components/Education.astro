---
import CertificateCarousel from "./CertificateCarousel.astro";

const education = [
  { school: "Coursera", program: "IBM UI/UX Designer Professional Certificate", period: "Jun 2026 — Sep 2026", link: "https://coursera.org/verify/professional-cert/BMXQFMYZY9A1" },
  { school: "Coursera", program: "Creative Design Tools: Adobe Photoshop, Illustrator, Acrobat", period: "Jan 2026 — Mar 2026", link: "https://www.coursera.org/account/accomplishments/specialization/0QBA1SAIQ8LS" },
  { school: "DICHI Academy", program: "UX/UI Design: Practical Design for Modern Interfaces", period: "Nov 2025 — Jan 2026" },
  { school: "Coursera", program: "Google UX Design Professional Certificate", period: "Aug 2025 — Feb 2026", link: "https://www.coursera.org/account/accomplishments/specialization/BP8MGYEQZPXI" },
  { school: "SETEC Institute", program: "Management Information Systems, General", period: "Dec 2024 — Present" },
];
---

<section id="education" class="section">
  <div class="wrap">
    <p class="eyebrow reveal center">Education</p>
    <h2 class="section-heading reveal center">Continuous learning</h2>

    <ul class="edu-list reveal">
      {
        education.map((e) => {
          const Tag = e.link ? "a" : "div";
          const external = e.link?.startsWith("http");
          return (
            <li class="edu-item">
              <Tag
                class="edu-item-inner"
                href={e.link}
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                <div class="edu-text">
                  <span class="edu-subtitle">{e.school}</span>
                  <span class="edu-title">{e.program}</span>
                </div>
                <span class="edu-date">{e.period}</span>
              </Tag>
            </li>
          );
        })
      }
    </ul>

    <CertificateCarousel />
  </div>
</section>

<style>
  .edu-list {
    max-width: 640px;
    margin: 48px auto 0;
  }

  .edu-item {
    border-top: 1px solid var(--color-border);
    font-size: 15px;
  }

  .edu-item:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .edu-item-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 16px 0;
    color: inherit;
    text-decoration: none;
  }

  a.edu-item-inner {
    cursor: pointer;
    transition: opacity 200ms var(--ease-out);
  }

  a.edu-item-inner:hover {
    opacity: 0.7;
  }

  a.edu-item-inner:hover .edu-title {
    color: var(--color-primary);
  }

  .edu-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .edu-title {
    font-weight: 500;
    transition: color 200ms var(--ease-out);
  }

  .edu-subtitle {
    color: var(--color-ink-soft);
    font-size: 14px;
  }

  .edu-date {
    color: var(--color-ink-soft);
    font-size: 14px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 559px) {
    .edu-item-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
