---
interface Props {
  accent: string;
}
const { accent } = Astro.props;
---

<div class="phone" style={`--accent: ${accent}`}>
  <div class="phone-notch"></div>
  <div class="phone-screen">
    <slot />
  </div>
</div>

<style>
  .phone {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 18;
    max-width: 220px;
    margin: 0 auto;
    background: #0b0b0d;
    border-radius: 34px;
    padding: 10px;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.08),
      0 24px 48px -16px rgba(0, 0, 0, 0.35);
  }

  .phone-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    height: 18px;
    background: #0b0b0d;
    border-radius: 0 0 12px 12px;
    z-index: 2;
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 24px;
    overflow: hidden;
    background: var(--accent);
  }
</style>
